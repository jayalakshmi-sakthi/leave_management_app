<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen to avoid white flash -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color (match Flutter splash) -->
    <item>
        <color android:color="#F4F6FA"/>
    </item>

    <!-- App icon in center -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher"/>
    </item>

</layer-list>
